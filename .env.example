PORT=5000
NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=chatify_db

REDIS_PASSWORD=your_secure_redis_password

DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/chatify_db

REDIS_URL=redis://:your_secure_redis_password@localhost:6379

PROD_DATABASE_URL=postgresql://<user>:<password>@<neon-hostname>/chatify_db?sslmode=require&uselibpqcompat=true
PROD_REDIS_URL=rediss://default:<password>@<upstash-endpoint>:6379

VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000/ws

PROD_VITE_API_URL=https://<your-render-app>.onrender.com
PROD_VITE_WS_URL=wss://<your-render-app>.onrender.com/ws

DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxx?key=xxxx

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change me